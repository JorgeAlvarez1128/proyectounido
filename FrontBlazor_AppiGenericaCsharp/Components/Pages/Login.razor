@page "/login"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@inject AuthSessionService Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesion | Arsenal</PageTitle>

<div class="login-page">
    <div class="login-visual">
        <img src="images/login-arsenal.jpg" alt="Imagen de inicio de sesion Arsenal" />
    </div>

    <div class="login-card">
        <div class="login-brand">
            <img src="images/logo-arsenal.png" alt="Logo Arsenal" />
            <div>
                <span>Proyecto Unido</span>
                <h1>Inicio de sesion</h1>
            </div>
        </div>

        <p class="login-subtitle">
            Ingresa con tu usuario y contrasena para acceder a los modulos habilitados.
        </p>

        @if (!string.IsNullOrWhiteSpace(_mensaje))
        {
            <div class="alert @(_exito ? "alert-success" : "alert-danger")" role="alert">@_mensaje</div>
        }

        <EditForm Model="_login" OnValidSubmit="OnSubmitAsync" FormName="loginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Usuario (email)</label>
                <InputText class="form-control form-control-lg" @bind-Value="_login.Usuario" />
            </div>

            <div class="mb-4">
                <label class="form-label">Contrasena</label>
                <InputText class="form-control form-control-lg" type="password" @bind-Value="_login.Contrasena" />
            </div>

            <button class="btn btn-primary btn-lg w-100" type="submit">Ingresar</button>
        </EditForm>
    </div>
</div>

@code {
    private readonly LoginRequest _login = new();
    private string? _mensaje;
    private bool _exito;

    private async Task OnSubmitAsync()
    {
        var (ok, mensaje) = await Auth.LoginAsync(_login);
        _exito = ok;
        _mensaje = ok ? "Bienvenido al sistema." : mensaje;

        if (ok)
        {
            Nav.NavigateTo("/");
        }
    }
}